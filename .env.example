# Optional cloud/runtime settings
PORT=7860
STORAGE_DIR=/app/storage

# Prefer a Railway/HF secret instead of storing this in storage/config.json
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Telegram outbound notifications (leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_SCRAPE=true
TELEGRAM_NOTIFY_AI=true
TELEGRAM_NOTIFY_BACKUP=true

# Background automation
AUTOMATION_ENABLED=true
SCHEDULER_TIMEZONE=UTC
SCRAPE_INTERVAL_MINUTES=60
SCRAPE_TOPIC=
SCRAPE_PLATFORM=All Platforms
SCRAPE_STORAGE_MODE=append
SCRAPE_FILE_NAME=scheduled_scrape
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=7

# Optional S3-compatible encrypted backup destination
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=my-personal-assistant
BACKUP_S3_ENDPOINT=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# Local RAG / feeds
RSS_FEEDS=
RSS_INTERVAL_MINUTES=30

# Weekly report
WEEKLY_REPORT_DAY=mon
WEEKLY_REPORT_HOUR=9

# Security monitoring
SECURITY_ALERTS_ENABLED=true
SECURITY_INTERVAL_MINUTES=5
RESOURCE_ALERT_PERCENT=90

# Signed external event webhook
WEBHOOK_SECRET=

# Telegram interactive bot + Mini-App webhook
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
